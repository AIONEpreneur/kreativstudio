# Diese Werte gehören in die Datei ~/.env (in deinem Benutzerordner),
# NICHT in eine .env im Projektordner. Keys bleiben immer auf deinem Rechner.

# Pflicht: für Bild- und Video-Generierung.
# Key erstellen auf https://fal.ai/dashboard/keys (Pay-per-Use, Guthaben aufladen)
FAL_KEY=<dein-fal-key>

# Optional: verbessert deine Prompts automatisch fürs jeweilige Modell.
# Key erstellen auf https://aistudio.google.com/apikey (kostenlose Stufe reicht)
GOOGLE_API_KEY=<dein-google-key>

# Optional: für Sprachausgabe (Text zu Stimme) im Audio-Reiter.
# Key erstellen auf https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=<dein-elevenlabs-key>
