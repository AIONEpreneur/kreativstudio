# Required for image and video generation.
FAL_KEY=<your-fal-key>

# Optional. Enables model-specific prompt refinement.
GOOGLE_API_KEY=<your-google-api-key>

# Optional local reference projects. Bench still runs when these are absent.
BENCH_WEBSITE_REFERENCE=/absolute/path/to/a/reference-website
BENCH_WEBSITE_REFERENCE_URL=http://localhost:5300/
BENCH_DOCUMENT_REFERENCE=/absolute/path/to/a/reference-document.html
